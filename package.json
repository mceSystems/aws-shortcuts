{
  "name": "aws-shortcut",
  "version": "0.1.0",
  "description": "Chrome extension for one-click access to AWS resources via SSO",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "icons:fetch": "tsx scripts/fetch-icons.ts",
    "icons:build": "tsx scripts/build-icons.ts",
    "icons:check": "tsx scripts/build-icons.ts --check",
    "catalog:merge": "tsx scripts/merge-harvested.ts",
    "predev": "npm run icons:build -- --allow-missing",
    "prebuild": "npm run icons:build -- --allow-missing"
  },
  "dependencies": {
    "preact": "^10.29.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.275",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "svgo": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
